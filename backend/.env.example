# Copy to backend/.env and adjust. Everything is optional.

# Free GitHub personal access token (no scopes needed for public repos).
# Without it GitHub allows ~60 API requests/hour; one analysis uses ~6-10.
GITHUB_TOKEN=

# SQLite database location (default: backend/data/skill_passport.db)
# DATABASE_URL=sqlite:///./data/skill_passport.db

# Limits
MAX_REPO_ZIP_MB=40
MAX_FILES_SCANNED=600
MAX_FILE_KB=300
MAX_COMMITS=100
MAX_FILE_HISTORY_LOOKUPS=5
MAX_RESUME_MB=5
GITHUB_TIMEOUT_SECONDS=25

# Frontend origins allowed by CORS, and base URL used for public share links
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173
